import serial
import requests

arduino = serial.Serial('COM3', 9600)

while True:
    if arduino.in_waiting > 0:
        uid = arduino.readline().decode().strip()
        response = requests.post("http://localhost/verificar_salida.php", data={"uid": uid})
        
        if response.text.strip() == "1":
            arduino.write(b'A')
        else:
            arduino.write(b'D')
